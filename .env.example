# ==============================================================================
# PRENSA NEXORAONE - CONFIGURACION DE ENTORNO (NEXORA ONE ENTERPRISE)
# ==============================================================================

# SUPABASE INDEPENDIENTE (Postgres & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# MONGODB ATLAS (Cerebro de Aprendizaje Evolutivo y Memoria M0 Free Tier)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.mongodb.net/prensa_nexoraone?retryWrites=true&w=majority

# MOTOR DE INFERENCIA PRIMARIO (Groq LPUs - Llama 3.3 70B & Whisper v3)
GROQ_API_KEY=tu-groq-api-key-aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# REDUNDANCIA MULTI-KEY GEMINI (Cero Caidas)
GEMINI_API_KEY=tu-gemini-key-1-aqui
GEMINI_API_KEY_FALLBACK=tu-gemini-key-2-aqui
GEMINI_API_KEY_FALLBACK_2=tu-gemini-key-3-aqui
GEMINI_MODEL=gemini-2.5-flash

# RESGUARDO DE RAZONAMIENTO PROFUNDO (SambaNova Cloud DeepSeek-R1)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL_TEXT=Meta-Llama-3.3-70B-Instruct

# CONECTOR WORDPRESS OFICIAL (Cadena 4)
WORDPRESS_SITE_URL=https://cadena4.com.ar
WORDPRESS_REST_ENDPOINT=/wp-json/wp/v2/posts
WORDPRESS_MEDIA_ENDPOINT=/wp-json/wp/v2/media
WORDPRESS_APP_USERNAME=redaccion
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# CONECTORES DE REDES SOCIALES (Meta Graph API & Telegram)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# AUTOMATIZADOR EXTERNO OPCIONAL (Make.com / n8n Webhook)
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=

# SEGURIDAD Y CLAVE MAESTRA DE REDACCION
STAFF_MASTER_KEY=NexoraPrensa2026!
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_NAME=Cadena 4
NEXT_PUBLIC_CLIENT_STATION="FM 94.5 • Televisora & Diario Digital"
